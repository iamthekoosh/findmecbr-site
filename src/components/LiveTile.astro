---
// A full-size tile for live information, such as a fuel price: icon, name, the value large, then a note.
// Fuel tiles' subtitles look like "225.9c · since 16 Nov", so the first part is the value.
import Icon from './Icon.astro';
import { hasIcon } from '../lib/icon-set.js';
const { fact } = Astro.props;
const [value, ...rest] = (fact.subtitle ?? '').split(' · ');
const icon = fact.icon && hasIcon(fact.icon) ? fact.icon : 'radio';
const none = !fact.price && fact.fuel;
---
<li class={`live-tile${none ? ' none' : ''}`}>
  <span class="live-name"><Icon name={icon} />{fact.label}</span>
  <span class="live-value">{value || '—'}</span>
  {rest.length > 0 && <small>{rest.join(' · ')}</small>}
</li>
