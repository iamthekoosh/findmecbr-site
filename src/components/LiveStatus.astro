---
// The live open status as a dropdown: the closed row says "Open now", "Closing in 20 mins",
// "Opening in 15 mins" or "Closed" with the next change, and opening it shows the week's hours
// with today picked out. The status is worked out in the visitor's browser, so it stays right
// between site rebuilds. Without JavaScript it reads "Opening hours" and still opens.
import Icon from './Icon.astro';
import { weekHours, shortDate } from '../lib/format.js';
const { hours = [], exceptions = [], closedDays = [] } = Astro.props;
const week = weekHours(hours, closedDays);
const DAY_INDEX = [1, 2, 3, 4, 5, 6, 0]; // weekHours lists Monday first.
---
{hours.length > 0 && (
  <details class="live" data-live data-hours={JSON.stringify(hours)} data-exceptions={JSON.stringify(exceptions)}>
    <summary>
      <span class="live-now" aria-live="polite">
        <span class="live-tag">Opening hours</span><span class="live-detail"></span>
      </span>
      <Icon name="chevron-right" class="live-chev" />
    </summary>
    <dl class="hours live-hours">
      {week.map((h, i) => <><dt data-day={DAY_INDEX[i]}>{h.day}</dt><dd data-day={DAY_INDEX[i]}>{h.text}</dd></>)}
    </dl>
    {exceptions.length > 0 && (
      <ul class="muted live-exceptions">{exceptions.map((x) => <li>{shortDate(x.date)}: {x.closed ? 'Closed' : `${x.opens} to ${x.closes}`}{x.note && ` (${x.note})`}</li>)}</ul>
    )}
  </details>
)}

<script>
  import { liveStatus, canberraNow } from '../lib/live-hours.js';
  const nodes = [...document.querySelectorAll('[data-live]')];
  const paint = () => {
    const now = canberraNow();
    for (const el of nodes) {
      const s = liveStatus(JSON.parse(el.dataset.hours), JSON.parse(el.dataset.exceptions), now);
      if (!s) continue;
      el.dataset.state = s.state;
      el.querySelector('.live-tag').textContent = s.text;
      el.querySelector('.live-detail').textContent = s.detail;
      for (const d of el.querySelectorAll('[data-day]')) d.classList.toggle('today', Number(d.dataset.day) === now.day);
    }
  };
  if (nodes.length) { paint(); setInterval(paint, 60_000); }
</script>
