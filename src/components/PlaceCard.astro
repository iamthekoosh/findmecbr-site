---
// A place in a list. The whole head is a tile to the place page. Utility buttons sit below.
import Icon from './Icon.astro';
import StatusTag from './StatusTag.astro';
import { shortDate, directionsUrl, telUrl } from '../lib/format.js';
const { place, showCentre = true, showChildren = true } = Astro.props;
const kids = showChildren ? (place.children ?? []) : [];
const where = [place.parent?.name ?? (place.centre && showCentre ? place.centre.name : null), place.suburb?.name].filter(Boolean).join(', ');
const directions = place.locationType === 'physical' ? directionsUrl(place) : '';
const initials = place.name.split(/\s+/).filter((w) => /^[A-Za-z]/.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
---
<article class="card">
  <a class="card-head" href={`/places/${place.slug}/`}>
    <span class="card-main">
      <span class="logo-slot">
        {place.logo ? <img src={place.logo.src} alt="" loading="lazy" /> : initials}
      </span>
      <span>
        <span class="name">{place.name}</span>
        <StatusTag status={place.postStatus} />
        <span class="sub">{[place.category?.label, where].filter(Boolean).join(' · ')}</span>
      </span>
    </span>
    <Icon name="chevron-right" />
  </a>
  {place.short && <p>{place.short}</p>}
  {kids.length > 0 && (
    <div class="card-kids">
      <p class="kicker">{kids.length} {kids.length === 1 ? 'place' : 'places'} inside</p>
      <ul>
        {kids.map((c) => (
          <li><a class="kid" href={`/places/${c.slug}/`}><span><b>{c.name}</b>{c.category && <small>{c.category.label}</small>}</span><Icon name="chevron-right" /></a></li>
        ))}
      </ul>
    </div>
  )}
  {(place.phone || directions || place.website) && (
    <div class="utils">
      {directions && <a class="btn" href={directions} rel="noopener"><Icon name="navigation" />Directions</a>}
      {place.phone && <a class="btn" href={telUrl(place.phone)}><Icon name="phone" />Call</a>}
      {place.website && <a class="btn" href={place.website} rel="noopener"><Icon name="globe" />Website</a>}
    </div>
  )}
  {place.checkedAt && <p class="stamp">Checked {shortDate(place.checkedAt)}</p>}
</article>
