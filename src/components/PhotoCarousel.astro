---
// A place's photos as a swipeable carousel. The main photo comes first.
// Works without JavaScript (swipe or scroll); the script adds the arrow buttons, the counter and the dots.
import Icon from './Icon.astro';
const { photos = [], name = '', placeholder = false } = Astro.props;
const list = [...photos].sort((a, b) => Number(!!b.primary) - Number(!!a.primary));
---
{list.length > 0 ? (
  <section class="carousel" aria-roledescription="carousel" aria-label={`Photos of ${name}`} data-carousel>
    <ul class="car-track" tabindex="0">
      {list.map((p, i) => (
        <li class="car-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${list.length}`}>
          <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          {p.credit && <small class="car-credit">Photo: {p.credit}</small>}
        </li>
      ))}
    </ul>
    {list.length > 1 && (
      <div class="car-bar" hidden>
        <button class="car-btn" type="button" data-prev aria-label="Previous photo"><Icon name="chevron-left" /></button>
        <div class="car-dots">{list.map((_, i) => <button type="button" class="car-dot" data-to={i} aria-label={`Photo ${i + 1}`} />)}</div>
        <span class="car-count" aria-live="polite"><span data-now>1</span> / {list.length}</span>
        <button class="car-btn" type="button" data-next aria-label="Next photo"><Icon name="chevron-right" /></button>
      </div>
    )}
  </section>
) : placeholder ? (
  <div class="photo tall car-empty"><Icon name="images" />Photos coming soon</div>
) : null}

<script>
  for (const root of document.querySelectorAll('[data-carousel]')) {
    const track = root.querySelector('.car-track');
    const bar = root.querySelector('.car-bar');
    if (!track || !bar) continue;
    const slides = [...track.children];
    const dots = [...root.querySelectorAll('.car-dot')];
    const now = root.querySelector('[data-now]');
    let at = 0;
    const go = (i) => {
      const n = (i + slides.length) % slides.length;
      mark(n);
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const mark = (i) => {
      at = i;
      now.textContent = String(i + 1);
      dots.forEach((d, k) => d.setAttribute('aria-current', k === i ? 'true' : 'false'));
    };
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== at) mark(i);
    }, { passive: true });
    root.querySelector('[data-prev]').addEventListener('click', () => go(at - 1));
    root.querySelector('[data-next]').addEventListener('click', () => go(at + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(at + 1); }
    });
    mark(0);
    bar.hidden = false;
  }
</script>
