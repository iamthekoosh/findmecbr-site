---
// Breadcrumb as tappable chips, with › between them. Pass [{ label, href }].
const { items = [] } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">›</span>}
        <a class="chip" href={item.href} aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</a>
      </li>
    ))}
  </ol>
</nav>
