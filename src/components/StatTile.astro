---
// One statistic as a tile: icon, the figure, what it is, and where it came from.
import Icon from './Icon.astro';
import { hasIcon } from '../lib/icon-set.js';
const { stat } = Astro.props;
const icon = stat.icon && hasIcon(stat.icon) ? stat.icon : 'chart-no-axes-column';
const source = [stat.source, stat.year].filter(Boolean).join(', ');
---
<li class="stat-tile">
  <Icon name={icon} />
  <span class="stat-value">{stat.value}</span>
  <span class="stat-label">{stat.label}</span>
  {source && <small>{stat.url ? <a href={stat.url} rel="noopener">{source}</a> : source}</small>}
</li>
