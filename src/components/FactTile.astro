---
// A fact about a place as a compact tile: icon, the fact and an optional subtitle.
import Icon from './Icon.astro';
import { hasIcon } from '../lib/icon-set.js';
import { factTile } from '../lib/format.js';
const { fact } = Astro.props;
const b = factTile(fact, hasIcon);
---
<li class="fact-tile">
  <Icon name={b.icon} />
  <span class="fact-text"><span class="fact-label">{b.label}</span>{b.subtitle && <><span class="fact-dot" aria-hidden="true"> · </span><span class="fact-sub">{b.subtitle}</span></>}</span>
</li>
