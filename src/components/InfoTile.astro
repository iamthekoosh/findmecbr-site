---
// One kind of information on a place (Information, Take note or Warning): a tile with the kind's coloured
// icon, word and count, which opens to show its entries. Each entry is its title, then " · " and any details.
import Icon from './Icon.astro';
import { INFO_KINDS } from '../lib/strapi.js';
const { kind, notes } = Astro.props;
const k = INFO_KINDS[kind];
---
<details class={`info-group info-${kind}`}>
  <summary>
    <Icon name={k.icon} />
    <span class="info-kind">{k.label}</span>
    <span class="info-count">{notes.length}</span>
    <Icon name="chevron-right" class="info-chev" />
  </summary>
  <ul class="info-list">
    {notes.map((n) => <li><span class="info-title">{n.title}</span>{n.details && <> · <span class="info-details">{n.details}</span></>}</li>)}
  </ul>
</details>
