---
// A Lucide icon (ISC licence, see /lucide-LICENSE.txt). Decorative, so hidden from screen readers.
import icons from '../lib/icons.json';
const { name, class: cls = '' } = Astro.props;
const body = icons[name] ?? icons['store'];
---
<svg class={`ic ${cls}`} viewBox="0 0 24 24" aria-hidden="true" set:html={body} />
