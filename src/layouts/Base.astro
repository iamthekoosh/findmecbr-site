---
// Page frame: header with the lockup, main content, footer. Mobile first.
import '@fontsource/familjen-grotesk/700.css';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '@fontsource/atkinson-hyperlegible-mono/400.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { STAGE } from '../lib/strapi.js';
import Icon from '../components/Icon.astro';
const { title, description = 'Canberra, suburb by suburb. Checked.' } = Astro.props;
const testing = STAGE !== 'live';
const noindex = Astro.props.noindex || testing;
const fullTitle = title ? `${title} | Find Me CBR` : 'Find Me CBR: Canberra, suburb by suburb. Checked.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname;
const menu = [
  { href: '/discover/', icon: 'compass', label: 'Discover' },
  { href: '/services/', icon: 'store', label: 'Businesses' },
  { href: '/search/', icon: 'search', label: 'Search' },
];
// Auto follows the phone or computer's own setting. Light and Dark are saved in this browser only.
const themes = [
  { value: 'auto', icon: 'sun-moon', label: 'Auto' },
  { value: 'light', icon: 'sun', label: 'Light' },
  { value: 'dark', icon: 'moon', label: 'Dark' },
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Runs before the page paints, so a saved Light or Dark choice doesn't flash the other colours.
      (function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')d.dataset.theme=t}catch(e){}})();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1F4D3A" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {testing && <p class="proto">{STAGE.toUpperCase()}: a test version. Listings may be incomplete.</p>}
    <header class="top">
      <div class="top-in">
        <a class="logo" href="/" aria-label="Find Me CBR home">
          <img class="logo-light" src="/lockup-horizontal-eucalypt.svg" alt="Find Me CBR" width="160" height="24" />
          <img class="logo-dark" src="/lockup-horizontal-paper.svg" alt="" width="160" height="24" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-menu"><Icon name="menu" class="when-shut" /><Icon name="x" class="when-open" />Menu</button>
      </div>
    </header>
    <div class="menu-wrap" id="main-menu">
      <nav class="menu" aria-label="Main">
        {menu.map((m) => <a href={m.href} aria-current={here.startsWith(m.href) ? 'page' : undefined}><Icon name={m.icon} />{m.label}</a>)}
        <div class="theme" role="group" aria-labelledby="theme-label">
          <span class="theme-label" id="theme-label">Colours</span>
          <div class="theme-opts">
            {themes.map((t) => <button type="button" data-theme-pick={t.value} aria-pressed={t.value === 'auto' ? 'true' : 'false'}><Icon name={t.icon} />{t.label}</button>)}
          </div>
        </div>
      </nav>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="stack">
        <nav class="foot-links" aria-label="About this site">
          <a href="/about/">About</a>
          <a href="/how-we-check/">How we check</a>
          <a href="/suggest/">Suggest a place</a>
          <a href="/corrections/">Corrections</a>
          <a href="/privacy/">Privacy</a>
          <a href="/advertise/">Advertise</a>
        </nav>
        <p class="muted">Find Me CBR acknowledges those Traditional Custodians with connections to Country in what we now call Canberra and the ACT. We pay our respect to Elders past and present.</p>
        <p class="muted">Independent. Not a government service. Listings are checked by hand and dated.</p>
        <p class="copyright">© {new Date().getFullYear()} Find Me CBR. All rights reserved.</p>
      </div>
    </footer>
    <script>
      // The main menu slides down from the header. Escape or a tap elsewhere closes it.
      const btn = document.querySelector('.menu-btn');
      const wrap = document.getElementById('main-menu');
      const set = (open) => { btn.setAttribute('aria-expanded', String(open)); wrap.classList.toggle('open', open); wrap.inert = !open; };
      set(false);
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && wrap.classList.contains('open')) { set(false); btn.focus(); } });
      document.addEventListener('click', (e) => { if (wrap.classList.contains('open') && !wrap.contains(e.target) && !btn.contains(e.target)) set(false); });

      // Colours: Auto, Light or Dark. The choice is kept in this browser (localStorage) and nowhere else.
      const root = document.documentElement;
      const picks = document.querySelectorAll('[data-theme-pick]');
      const show = (t) => picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themePick === t)));
      show(root.dataset.theme || 'auto');
      picks.forEach((b) => b.addEventListener('click', () => {
        const t = b.dataset.themePick;
        if (t === 'auto') delete root.dataset.theme; else root.dataset.theme = t;
        try { if (t === 'auto') localStorage.removeItem('theme'); else localStorage.setItem('theme', t); } catch {}
        show(t);
      }));
    </script>
  </body>
</html>
