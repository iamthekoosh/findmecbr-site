---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { loadSite } from '../lib/strapi.js';

const site = await loadSite();
// The home page shows districts only. Suburbs, shops and centres are one tap away on each district page.
const districts = site.districts
  .map((d) => ({
    ...d,
    suburbs: site.suburbs.filter((s) => s.district?.slug === d.slug && site.pagedSuburbs.has(s.slug)).length,
    centres: site.centres.filter((c) => c.district?.slug === d.slug).length,
  }))
  .filter((d) => d.suburbs);
const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
---
<Base>
  <h1 class="blade">Canberra, Suburb by Suburb</h1>
  <p class="lede">Local places, checked by hand and dated. Starting with Weston Creek and Molonglo Valley.</p>

  <section class="section">
    <h2>Choose a District</h2>
    <div class="district-grid">
      {districts.map((d) => (
        <a class={`district-tile${d.image ? ' has-img' : ''}`} href={`/districts/${d.slug}/`}>
          {d.image && <img src={d.image.src} alt="" loading="lazy" decoding="async" />}
          <Icon name="compass" />
          <span>{d.name}<small>{plural(d.suburbs, "suburb")}{d.centres > 0 && <><br />{plural(d.centres, "shopping area")}</>}</small></span>
        </a>
      ))}
    </div>
  </section>
</Base>
