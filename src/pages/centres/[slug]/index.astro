---
// A named place, such as Cooleman Court: a directory of every published place inside it.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PlaceCard from '../../../components/PlaceCard.astro';
import { loadSite, byCategory } from '../../../lib/strapi.js';
import Crumbs from '../../../components/Crumbs.astro';
import FactTile from '../../../components/FactTile.astro';
import { typeOf, directionsUrl, hideListedChildren, orderFacts } from '../../../lib/format.js';

export async function getStaticPaths() {
  const site = await loadSite();
  return site.centres.map((centre) => ({ params: { slug: centre.slug }, props: { centre } }));
}

const { centre } = Astro.props;
const site = await loadSite();
const inside = site.places.filter((p) => p.centre?.slug === centre.slug);
// A place inside another place here shows on its parent's card, not on its own.
const groups = byCategory(hideListedChildren(inside));
const type = typeOf(centre.kind);
const crumbs = centre.district
  ? [{ label: centre.district.name, href: `/districts/${centre.district.slug}/` }, { label: type.label, href: `/districts/${centre.district.slug}/${type.slug}/` }]
  : [];
const desc = centre.intro || `Every checked place in ${centre.name}${centre.suburb ? `, ${centre.suburb.name}` : ''}.`;
// Tiles: those in a tile set show under its heading; the rest under "What we know".
const tileSets = centre.tileSets ?? [];
const inSets = new Set(tileSets.flatMap((s) => s.tiles.map((t) => t.slug)));
const features = (centre.facts ?? []).filter((f) => !inSets.has(f.slug));
const directions = directionsUrl({ address: centre.address || centre.name, suburb: centre.suburb });
---
<Base title={centre.name} description={desc} noindex={!centre.live || inside.length === 0}>
  <Crumbs items={crumbs} />
  {centre.suburb && <p class="kicker">{centre.suburb.name}</p>}
  <h1>{centre.name}</h1>
  {centre.image && <img class="photo tall" src={centre.image.src} alt={centre.image.alt} />}
  {centre.intro && <p class="lede">{centre.intro}</p>}
  <div class="utils">
    <a class="btn" href={directions} rel="noopener"><Icon name="navigation" />Directions</a>
  </div>

  {tileSets.map((set) => (
    <section class="section">
      <h2>{set.heading}</h2>
      <ul class="fact-tiles">{set.tiles.map((f) => <FactTile fact={f} />)}</ul>
    </section>
  ))}

  {features.length > 0 && (
    <section class="section">
      <h2>What we know</h2>
      <ul class="fact-tiles">{orderFacts(features).map((f) => <FactTile fact={f} />)}</ul>
    </section>
  )}

  <section class="section">
    <h2>Directory</h2>
    {inside.length === 0
      ? <p class="empty">We haven't checked any places in {centre.name} yet. They'll appear here, grouped by type, once they have been.</p>
      : <p class="muted">{inside.length} checked {inside.length === 1 ? 'place' : 'places'} in {centre.name}.</p>}
  </section>

  {groups.map((g) => (
    <section class="section">
      <h2 class="h2row"><Icon name={g.category.icon || 'store'} />{g.category.plural}</h2>
      <div class="stack">{g.places.map((p) => <PlaceCard place={p} showCentre={false} />)}</div>
    </section>
  ))}
</Base>
