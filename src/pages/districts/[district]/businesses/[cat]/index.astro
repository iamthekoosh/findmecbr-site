---
// One business category across a district, e.g. Cafes in Weston Creek.
// Built only where there's at least one published place.
import Base from '../../../../../layouts/Base.astro';
import Crumbs from '../../../../../components/Crumbs.astro';
import PlaceCard from '../../../../../components/PlaceCard.astro';
import { loadSite, placesInDistrict } from '../../../../../lib/strapi.js';

export async function getStaticPaths() {
  const site = await loadSite();
  const paths = [];
  for (const district of site.districts.filter((d) => site.pagedDistricts.has(d.slug))) {
    for (const category of site.categories.filter((c) => c.active && c.kind !== 'service')) {
      const places = placesInDistrict(site, district, category);
      if (places.length) paths.push({ params: { district: district.slug, cat: category.slug }, props: { district, category, places } });
    }
  }
  return paths;
}

const { district, category, places } = Astro.props;
const title = `${category.plural} in ${district.name}`;
---
<Base title={title} description={`${title}, Canberra. Checked by hand, with the date we last checked.`}>
  <Crumbs items={[{ label: district.name, href: `/districts/${district.slug}/` }]} />
  <h1>{title}</h1>
  <div class="stack">{places.map((p) => <PlaceCard place={p} />)}</div>
</Base>
