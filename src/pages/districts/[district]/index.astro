---
// A district: a short description, photos, Essential services, Services and Businesses as tiles, then its suburbs and its centres by type.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PhotoCarousel from '../../../components/PhotoCarousel.astro';
import { loadSite, districtSections, STAGE } from '../../../lib/strapi.js';
import { CENTRE_TYPES, titleCase } from '../../../lib/format.js';

export async function getStaticPaths() {
  const site = await loadSite();
  return site.districts.filter((d) => site.pagedDistricts.has(d.slug)).map((district) => ({ params: { district: district.slug }, props: { district } }));
}

const { district } = Astro.props;
const site = await loadSite();
const suburbs = site.suburbs.filter((s) => s.district?.slug === district.slug && site.pagedSuburbs.has(s.slug));
const centres = site.centres.filter((c) => c.district?.slug === district.slug);
const types = Object.entries(CENTRE_TYPES)
  .map(([kind, t]) => ({ ...t, count: centres.filter((c) => c.kind === kind).length }))
  .filter((t) => t.count > 0);
const alpha = STAGE === 'alpha';
const sections = districtSections(site, district);
// How many category icons a closed dropdown shows before "+N".
const ICONS_SHOWN = 5;
---
<Base title={district.name} description={district.intro || `Suburbs, local shops and centres in ${district.name}, Canberra.`} noindex={suburbs.length === 0}>
  <p class="kicker">District</p>
  <h1>{district.name}</h1>
  {district.intro && <p class="lede">{district.intro}</p>}

  <PhotoCarousel photos={district.photos ?? []} name={district.name} placeholder={alpha} />

  {sections.map((sec) => (sec.list.length > 0 || alpha) && (
    <section class="section">
      <h2>{titleCase(sec.title)}</h2>
      {sec.groups ? (
        <div class="stack">
          {sec.groups.map((g) => (
            <details class="cat-group">
              <summary>
                <span class="cat-group-main">
                  <span class="cat-group-name">{titleCase(g.name)}</span>
                  <span class="cat-group-icons" aria-hidden="true">
                    {g.list.slice(0, ICONS_SHOWN).map((c) => <Icon name={c.icon || 'store'} />)}
                    {g.list.length > ICONS_SHOWN && <span class="cat-group-more">+{g.list.length - ICONS_SHOWN}</span>}
                  </span>
                  <span class="sr-only">{g.list.length} {g.list.length === 1 ? 'category' : 'categories'}</span>
                </span>
                <span class="count-pill"><b>{g.count}</b><span>{g.count === 1 ? 'place' : 'places'}</span></span>
                <Icon name="chevron-down" class="cat-group-chev" />
              </summary>
              <div class="grid">
                {g.list.map((c) => (
                  <a class="gt counted" href={`/districts/${district.slug}/${sec.key}/${c.slug}/`}>
                    <Icon name={c.icon || 'store'} />
                    <span class="gt-name">{c.plural}</span>
                    <span class="count-badge">{c.count}<span class="sr-only"> {c.count === 1 ? 'place' : 'places'}</span></span>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      ) : sec.list.length > 0 ? (
        <div class="grid">
          {sec.list.map((c) => (
            <a class="gt counted" href={`/districts/${district.slug}/${sec.key}/${c.slug}/`}>
              <Icon name={c.icon || 'store'} />
              <span class="gt-name">{c.plural}</span>
              <span class="count-badge">{c.count}<span class="sr-only"> {c.count === 1 ? 'place' : 'places'}</span></span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">{sec.title} in {district.name} appear here once they've been checked.</p>
      )}
    </section>
  ))}

  {suburbs.length > 0 && (
    <section class="section">
      <h2>Suburbs</h2>
      <div class="grid">
        {suburbs.map((s) => <a class="gt" href={`/suburbs/${s.slug}/`}><Icon name="map" /><span>{s.name}</span></a>)}
      </div>
    </section>
  )}

  {types.length > 0 && (
    <section class="section">
      <h2>Shops and Centres</h2>
      <div class="stack">
        {types.map((t) => (
          <a class="rowtile" href={`/districts/${district.slug}/${t.slug}/`}>
            <span><Icon name="store" class="lead" /><span>{t.heading}<small>{t.count} in {district.name}</small></span></span>
            <Icon name="chevron-right" />
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
