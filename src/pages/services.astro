---
// Businesses and services: every category in dropdowns by category Group, with the same tiles as district pages.
// A category shows only when it's switched on in Strapi and has at least one published place.
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import { loadSite } from '../lib/strapi.js';

const site = await loadSite();
const count = (slug) => site.places.filter((p) => p.category?.slug === slug).length;
const shown = site.categories.filter((c) => c.active).map((c) => ({ ...c, count: count(c.slug) })).filter((c) => c.count > 0)
  .sort((x, y) => x.plural.localeCompare(y.plural));
const href = (c) => `/search/?cat=${c.slug}`;
---
<Base title="Businesses and services" description="Find GPs, tradies, cleaners and local shops in Weston Creek and Molonglo Valley, with checked details.">
  <h1>Businesses and Services</h1>
  <SearchBox />
  {shown.length > 0 ? (
    <section class="section">
      <CategoryTiles list={shown} href={href} grouped />
    </section>
  ) : <p class="empty">Businesses appear here once enough in a category have been checked.</p>}
</Base>
