---
import Base from '../../layouts/Base.astro';
import Form from '../../components/Form.astro';
---
<Base title="Tell us what's wrong" noindex>
  <h1>Tell Us What's Wrong</h1>
  <p>We check every report before changing anything.</p>
  <Form kind="report" fields={[
    { name: 'what', label: "What's wrong?", type: 'textarea', required: true },
    { name: 'contact', label: "Your email, if you'd like a reply (optional)", type: 'email', autocomplete: 'email' },
  ]} />
</Base>
